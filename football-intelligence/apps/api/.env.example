# Server-only Gemini configuration. Copy to .env locally; never commit .env.
GEMINI_API_KEY=replace_with_your_private_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
WEB_ORIGIN=http://localhost:3000

# Non-secret video-provider settings. Keep any provider stream token server-side
# under a separate private key; never mirror it to a NEXT_PUBLIC variable.
SPORTZFY_ENABLED=true
SPORTZFY_DOWNLOAD_URL=https://apk.sportzfy.app/download
SPORTZFY_APP_DEEP_LINK=
SPORTZFY_EMBED_URL=
SPORTZFY_STREAM_API_URL=
